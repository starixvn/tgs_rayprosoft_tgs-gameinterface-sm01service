<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
	<TargetFramework>net7.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<Version>0.0.7</Version>
	<Authors>Raypro</Authors>
	<Description>Tgs GameInterface SM01 Client</Description>
	<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-sm01service</PackageProjectUrl>
	<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-sm01service.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
		<PackageReference Include="Grpc.Tools" Version="2.56.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.SM01Service\Protos\gameinterfacesm01service.proto">
	    <Link>gameinterfacesm01service.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
